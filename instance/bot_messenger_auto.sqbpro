<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="bot_messenger_auto.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="1"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1141"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Faq_User" custom_title="0" dock_id="1" table="4,8:mainFaq_User"/><dock_state state="000000ff00000000fd00000001000000020000043c000002b6fc0100000001fb000000160064006f0063006b00420072006f007700730065003101000000000000043c0000012400ffffff000002580000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="Faq_User" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="29"/><column index="2" value="29"/><column index="3" value="49"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">INSERT INTO Faq_User (ask, answer) VALUES ('Công nghệ thông tin là gì?', 'Công nghệ thông tin (CNTT) là lĩnh vực sử dụng máy tính, phần mềm và mạng để tạo ra, lưu trữ, xử lý, truyền tải và bảo vệ thông tin. Ngành này gồm nhiều hướng như lập trình, mạng máy tính, cơ sở dữ liệu, an toàn thông tin, trí tuệ nhân tạo và kỹ thuật phần mềm.');
INSERT INTO Faq_User (ask, answer) VALUES ('CNTT là ngành học về cái gì?', 'Công nghệ thông tin (CNTT) là lĩnh vực sử dụng máy tính, phần mềm và mạng để tạo ra, lưu trữ, xử lý, truyền tải và bảo vệ thông tin. Ngành này gồm nhiều hướng như lập trình, mạng máy tính, cơ sở dữ liệu, an toàn thông tin, trí tuệ nhân tạo và kỹ thuật phần mềm.');
INSERT INTO Faq_User (ask, answer) VALUES ('Thuật toán là gì?', 'Thuật toán là một dãy hữu hạn các bước rõ ràng để giải một bài toán hoặc thực hiện một công việc. Một thuật toán tốt cần có đầu vào, đầu ra, các bước xác định, dừng sau hữu hạn bước và cho kết quả đúng.');
INSERT INTO Faq_User (ask, answer) VALUES ('Algorithm nghĩa là gì trong lập trình?', 'Thuật toán là một dãy hữu hạn các bước rõ ràng để giải một bài toán hoặc thực hiện một công việc. Một thuật toán tốt cần có đầu vào, đầu ra, các bước xác định, dừng sau hữu hạn bước và cho kết quả đúng.');
INSERT INTO Faq_User (ask, answer) VALUES ('Lập trình là gì?', 'Lập trình là việc viết các chỉ dẫn để máy tính thực hiện một nhiệm vụ. Ngôn ngữ lập trình là bộ quy tắc và cú pháp dùng để viết các chỉ dẫn đó, ví dụ Python, Java, C++, JavaScript.');
INSERT INTO Faq_User (ask, answer) VALUES ('Ngôn ngữ lập trình là gì?', 'Lập trình là việc viết các chỉ dẫn để máy tính thực hiện một nhiệm vụ. Ngôn ngữ lập trình là bộ quy tắc và cú pháp dùng để viết các chỉ dẫn đó, ví dụ Python, Java, C++, JavaScript.');
INSERT INTO Faq_User (ask, answer) VALUES ('Người mới nên học ngôn ngữ lập trình nào đầu tiên?', 'Python thường được khuyên cho người mới vì cú pháp ngắn gọn, dễ đọc và dùng được cho web, dữ liệu, AI. Nếu muốn hiểu sâu về bộ nhớ và cách máy tính hoạt động, bạn có thể học thêm C hoặc C++; muốn làm web thì học thêm JavaScript.');
INSERT INTO Faq_User (ask, answer) VALUES ('Mới bắt đầu học code thì nên chọn ngôn ngữ nào?', 'Python thường được khuyên cho người mới vì cú pháp ngắn gọn, dễ đọc và dùng được cho web, dữ liệu, AI. Nếu muốn hiểu sâu về bộ nhớ và cách máy tính hoạt động, bạn có thể học thêm C hoặc C++; muốn làm web thì học thêm JavaScript.');
INSERT INTO Faq_User (ask, answer) VALUES ('Trình biên dịch và trình thông dịch khác nhau thế nào?', 'Trình biên dịch (compiler) dịch toàn bộ mã nguồn thành mã máy trước khi chạy, như C và C++, nên chương trình chạy nhanh. Trình thông dịch (interpreter) đọc và thực thi mã từng phần trong lúc chạy, như Python hay JavaScript, nên linh hoạt và dễ thử nghiệm hơn nhưng thường chậm hơn.');
INSERT INTO Faq_User (ask, answer) VALUES ('Compiler và interpreter khác nhau ra sao?', 'Trình biên dịch (compiler) dịch toàn bộ mã nguồn thành mã máy trước khi chạy, như C và C++, nên chương trình chạy nhanh. Trình thông dịch (interpreter) đọc và thực thi mã từng phần trong lúc chạy, như Python hay JavaScript, nên linh hoạt và dễ thử nghiệm hơn nhưng thường chậm hơn.');
INSERT INTO Faq_User (ask, answer) VALUES ('Lập trình hướng đối tượng (OOP) là gì?', 'Lập trình hướng đối tượng tổ chức chương trình thành các đối tượng, mỗi đối tượng gồm dữ liệu (thuộc tính) và hành vi (phương thức). Bốn tính chất chính là đóng gói, kế thừa, đa hình và trừu tượng.');
INSERT INTO Faq_User (ask, answer) VALUES ('Bốn tính chất của OOP là gì?', 'Lập trình hướng đối tượng tổ chức chương trình thành các đối tượng, mỗi đối tượng gồm dữ liệu (thuộc tính) và hành vi (phương thức). Bốn tính chất chính là đóng gói, kế thừa, đa hình và trừu tượng.');
INSERT INTO Faq_User (ask, answer) VALUES ('Biến và kiểu dữ liệu là gì?', 'Biến là vùng nhớ có tên dùng để lưu một giá trị trong chương trình. Kiểu dữ liệu cho biết loại giá trị mà biến chứa và các phép toán áp dụng được; các kiểu cơ bản gồm số nguyên, số thực, ký tự, chuỗi và logic (đúng/sai).');
INSERT INTO Faq_User (ask, answer) VALUES ('Kiểu dữ liệu trong lập trình gồm những loại nào?', 'Biến là vùng nhớ có tên dùng để lưu một giá trị trong chương trình. Kiểu dữ liệu cho biết loại giá trị mà biến chứa và các phép toán áp dụng được; các kiểu cơ bản gồm số nguyên, số thực, ký tự, chuỗi và logic (đúng/sai).');
INSERT INTO Faq_User (ask, answer) VALUES ('Đệ quy là gì?', 'Đệ quy là kỹ thuật trong đó một hàm tự gọi lại chính nó với bài toán nhỏ hơn. Hàm đệ quy bắt buộc phải có điều kiện dừng, nếu không sẽ gọi vô hạn và gây tràn ngăn xếp; ví dụ điển hình là tính giai thừa và dãy Fibonacci.');
INSERT INTO Faq_User (ask, answer) VALUES ('Hàm đệ quy hoạt động như thế nào?', 'Đệ quy là kỹ thuật trong đó một hàm tự gọi lại chính nó với bài toán nhỏ hơn. Hàm đệ quy bắt buộc phải có điều kiện dừng, nếu không sẽ gọi vô hạn và gây tràn ngăn xếp; ví dụ điển hình là tính giai thừa và dãy Fibonacci.');
INSERT INTO Faq_User (ask, answer) VALUES ('Python: list, tuple, dict và set khác nhau thế nào?', 'List ([ ]) là danh sách có thứ tự và thay đổi được. Tuple (( )) giống list nhưng không thay đổi được sau khi tạo. Dict ({khóa: giá trị}) lưu cặp khóa - giá trị để tra cứu nhanh. Set là tập hợp các phần tử không trùng nhau, không quan tâm thứ tự.');
INSERT INTO Faq_User (ask, answer) VALUES ('Khi nào dùng list, tuple, dictionary, set trong Python?', 'List ([ ]) là danh sách có thứ tự và thay đổi được. Tuple (( )) giống list nhưng không thay đổi được sau khi tạo. Dict ({khóa: giá trị}) lưu cặp khóa - giá trị để tra cứu nhanh. Set là tập hợp các phần tử không trùng nhau, không quan tâm thứ tự.');
-- ===== DSA =====
INSERT INTO Faq_User (ask, answer) VALUES ('Cấu trúc dữ liệu là gì?', 'Cấu trúc dữ liệu là cách tổ chức và lưu trữ dữ liệu để truy cập và xử lý hiệu quả. Các cấu trúc phổ biến gồm mảng, danh sách liên kết, ngăn xếp (stack), hàng đợi (queue), bảng băm (hash table), cây (tree) và đồ thị (graph).');
INSERT INTO Faq_User (ask, answer) VALUES ('Các cấu trúc dữ liệu phổ biến gồm những gì?', 'Cấu trúc dữ liệu là cách tổ chức và lưu trữ dữ liệu để truy cập và xử lý hiệu quả. Các cấu trúc phổ biến gồm mảng, danh sách liên kết, ngăn xếp (stack), hàng đợi (queue), bảng băm (hash table), cây (tree) và đồ thị (graph).');
INSERT INTO Faq_User (ask, answer) VALUES ('Stack và queue khác nhau thế nào?', 'Stack (ngăn xếp) hoạt động theo nguyên tắc vào sau ra trước (LIFO): phần tử thêm vào sau cùng sẽ được lấy ra đầu tiên, như chồng đĩa. Queue (hàng đợi) hoạt động theo nguyên tắc vào trước ra trước (FIFO), như xếp hàng mua vé.');
INSERT INTO Faq_User (ask, answer) VALUES ('Ngăn xếp và hàng đợi khác nhau ở điểm nào?', 'Stack (ngăn xếp) hoạt động theo nguyên tắc vào sau ra trước (LIFO): phần tử thêm vào sau cùng sẽ được lấy ra đầu tiên, như chồng đĩa. Queue (hàng đợi) hoạt động theo nguyên tắc vào trước ra trước (FIFO), như xếp hàng mua vé.');
INSERT INTO Faq_User (ask, answer) VALUES ('Độ phức tạp thuật toán Big-O là gì?', 'Big-O mô tả mức tăng của thời gian chạy (hoặc bộ nhớ) của thuật toán khi kích thước dữ liệu n tăng lên. Một số mức thường gặp từ nhanh đến chậm: O(1), O(log n), O(n), O(n log n), O(n²).');
INSERT INTO Faq_User (ask, answer) VALUES ('Big O notation dùng để làm gì?', 'Big-O mô tả mức tăng của thời gian chạy (hoặc bộ nhớ) của thuật toán khi kích thước dữ liệu n tăng lên. Một số mức thường gặp từ nhanh đến chậm: O(1), O(log n), O(n), O(n log n), O(n²).');
INSERT INTO Faq_User (ask, answer) VALUES ('Các thuật toán sắp xếp phổ biến là gì?', 'Bubble sort đơn giản nhưng chậm, độ phức tạp O(n²). Quick sort trung bình O(n log n), nhanh trong thực tế nhưng trường hợp xấu nhất là O(n²). Merge sort luôn O(n log n) và ổn định nhưng cần thêm bộ nhớ phụ.');
INSERT INTO Faq_User (ask, answer) VALUES ('So sánh bubble sort, quick sort và merge sort', 'Bubble sort đơn giản nhưng chậm, độ phức tạp O(n²). Quick sort trung bình O(n log n), nhanh trong thực tế nhưng trường hợp xấu nhất là O(n²). Merge sort luôn O(n log n) và ổn định nhưng cần thêm bộ nhớ phụ.');
INSERT INTO Faq_User (ask, answer) VALUES ('Tìm kiếm nhị phân là gì?', 'Tìm kiếm nhị phân tìm một giá trị trong mảng đã sắp xếp bằng cách so sánh với phần tử ở giữa rồi loại bỏ một nửa mảng ở mỗi bước. Độ phức tạp là O(log n), nhanh hơn nhiều so với tìm tuần tự O(n).');
INSERT INTO Faq_User (ask, answer) VALUES ('Binary search hoạt động như thế nào?', 'Tìm kiếm nhị phân tìm một giá trị trong mảng đã sắp xếp bằng cách so sánh với phần tử ở giữa rồi loại bỏ một nửa mảng ở mỗi bước. Độ phức tạp là O(log n), nhanh hơn nhiều so với tìm tuần tự O(n).');
-- ===== CSDL =====
INSERT INTO Faq_User (ask, answer) VALUES ('Cơ sở dữ liệu là gì?', 'Cơ sở dữ liệu là tập hợp dữ liệu có tổ chức, được lưu trữ để truy vấn và cập nhật dễ dàng. Hệ quản trị cơ sở dữ liệu (DBMS) là phần mềm quản lý cơ sở dữ liệu, ví dụ MySQL, PostgreSQL, SQL Server, Oracle và SQLite.');
INSERT INTO Faq_User (ask, answer) VALUES ('Hệ quản trị cơ sở dữ liệu là gì?', 'Cơ sở dữ liệu là tập hợp dữ liệu có tổ chức, được lưu trữ để truy vấn và cập nhật dễ dàng. Hệ quản trị cơ sở dữ liệu (DBMS) là phần mềm quản lý cơ sở dữ liệu, ví dụ MySQL, PostgreSQL, SQL Server, Oracle và SQLite.');
INSERT INTO Faq_User (ask, answer) VALUES ('SQL là gì?', 'SQL (Structured Query Language) là ngôn ngữ truy vấn dùng để làm việc với cơ sở dữ liệu quan hệ. Các lệnh thao tác dữ liệu cơ bản là SELECT, INSERT, UPDATE, DELETE; các lệnh định nghĩa cấu trúc gồm CREATE, ALTER, DROP.');
INSERT INTO Faq_User (ask, answer) VALUES ('Các câu lệnh SQL cơ bản gồm những gì?', 'SQL (Structured Query Language) là ngôn ngữ truy vấn dùng để làm việc với cơ sở dữ liệu quan hệ. Các lệnh thao tác dữ liệu cơ bản là SELECT, INSERT, UPDATE, DELETE; các lệnh định nghĩa cấu trúc gồm CREATE, ALTER, DROP.');
INSERT INTO Faq_User (ask, answer) VALUES ('Khóa chính và khóa ngoại là gì?', 'Khóa chính (primary key) là cột hoặc nhóm cột xác định duy nhất mỗi bản ghi trong bảng, không được trùng và không được rỗng. Khóa ngoại (foreign key) là cột tham chiếu tới khóa chính của bảng khác để tạo mối quan hệ giữa hai bảng.');
INSERT INTO Faq_User (ask, answer) VALUES ('Primary key và foreign key khác nhau thế nào?', 'Khóa chính (primary key) là cột hoặc nhóm cột xác định duy nhất mỗi bản ghi trong bảng, không được trùng và không được rỗng. Khóa ngoại (foreign key) là cột tham chiếu tới khóa chính của bảng khác để tạo mối quan hệ giữa hai bảng.');
INSERT INTO Faq_User (ask, answer) VALUES ('SQL và NoSQL khác nhau thế nào?', 'SQL (cơ sở dữ liệu quan hệ) lưu dữ liệu trong bảng với cấu trúc cố định và hỗ trợ truy vấn, ràng buộc chặt chẽ. NoSQL như MongoDB hay Redis có cấu trúc linh hoạt (tài liệu, khóa - giá trị, đồ thị), phù hợp dữ liệu thay đổi nhiều hoặc cần mở rộng quy mô lớn.');
INSERT INTO Faq_User (ask, answer) VALUES ('Khi nào nên dùng NoSQL thay cho SQL?', 'SQL (cơ sở dữ liệu quan hệ) lưu dữ liệu trong bảng với cấu trúc cố định và hỗ trợ truy vấn, ràng buộc chặt chẽ. NoSQL như MongoDB hay Redis có cấu trúc linh hoạt (tài liệu, khóa - giá trị, đồ thị), phù hợp dữ liệu thay đổi nhiều hoặc cần mở rộng quy mô lớn.');
INSERT INTO Faq_User (ask, answer) VALUES ('Chuẩn hóa cơ sở dữ liệu là gì?', 'Chuẩn hóa là quá trình tổ chức bảng để giảm dư thừa và tránh lỗi khi cập nhật dữ liệu. 1NF yêu cầu mỗi ô chỉ chứa một giá trị nguyên tử; 2NF yêu cầu thuộc tính không khóa không phụ thuộc vào một phần của khóa; 3NF yêu cầu không có phụ thuộc bắc cầu giữa các thuộc tính không khóa.');
INSERT INTO Faq_User (ask, answer) VALUES ('Dạng chuẩn 1NF, 2NF, 3NF là gì?', 'Chuẩn hóa là quá trình tổ chức bảng để giảm dư thừa và tránh lỗi khi cập nhật dữ liệu. 1NF yêu cầu mỗi ô chỉ chứa một giá trị nguyên tử; 2NF yêu cầu thuộc tính không khóa không phụ thuộc vào một phần của khóa; 3NF yêu cầu không có phụ thuộc bắc cầu giữa các thuộc tính không khóa.');
INSERT INTO Faq_User (ask, answer) VALUES ('JOIN trong SQL là gì?', 'JOIN dùng để kết hợp dữ liệu từ nhiều bảng dựa trên cột liên quan. INNER JOIN chỉ trả về các dòng có giá trị khớp ở cả hai bảng, còn LEFT JOIN trả về tất cả dòng của bảng bên trái kèm dòng khớp từ bảng bên phải (không khớp thì để NULL).');
INSERT INTO Faq_User (ask, answer) VALUES ('INNER JOIN và LEFT JOIN khác nhau thế nào?', 'JOIN dùng để kết hợp dữ liệu từ nhiều bảng dựa trên cột liên quan. INNER JOIN chỉ trả về các dòng có giá trị khớp ở cả hai bảng, còn LEFT JOIN trả về tất cả dòng của bảng bên trái kèm dòng khớp từ bảng bên phải (không khớp thì để NULL).');
-- ===== HĐH =====
INSERT INTO Faq_User (ask, answer) VALUES ('Hệ điều hành là gì?', 'Hệ điều hành là phần mềm hệ thống quản lý phần cứng và tài nguyên của máy tính, đồng thời cung cấp môi trường cho các ứng dụng chạy. Các chức năng chính gồm quản lý tiến trình, bộ nhớ, tệp và thiết bị; ví dụ Windows, Linux, macOS, Android, iOS.');
INSERT INTO Faq_User (ask, answer) VALUES ('Hệ điều hành có vai trò gì?', 'Hệ điều hành là phần mềm hệ thống quản lý phần cứng và tài nguyên của máy tính, đồng thời cung cấp môi trường cho các ứng dụng chạy. Các chức năng chính gồm quản lý tiến trình, bộ nhớ, tệp và thiết bị; ví dụ Windows, Linux, macOS, Android, iOS.');
INSERT INTO Faq_User (ask, answer) VALUES ('Tiến trình và luồng khác nhau thế nào?', 'Tiến trình (process) là một chương trình đang chạy và có không gian bộ nhớ riêng. Luồng (thread) là đơn vị thực thi nhỏ hơn nằm trong tiến trình và chia sẻ bộ nhớ với các luồng khác của cùng tiến trình, nên tạo và chuyển đổi nhẹ hơn nhưng dễ xảy ra xung đột dữ liệu.');
INSERT INTO Faq_User (ask, answer) VALUES ('Process và thread khác nhau ở điểm nào?', 'Tiến trình (process) là một chương trình đang chạy và có không gian bộ nhớ riêng. Luồng (thread) là đơn vị thực thi nhỏ hơn nằm trong tiến trình và chia sẻ bộ nhớ với các luồng khác của cùng tiến trình, nên tạo và chuyển đổi nhẹ hơn nhưng dễ xảy ra xung đột dữ liệu.');
INSERT INTO Faq_User (ask, answer) VALUES ('RAM và ổ cứng khác nhau thế nào?', 'RAM là bộ nhớ tạm thời, tốc độ cao, dùng cho dữ liệu đang xử lý và mất nội dung khi tắt máy. ROM chứa dữ liệu cố định như firmware khởi động. Ổ cứng HDD hoặc SSD lưu dữ liệu lâu dài; SSD nhanh hơn HDD vì không có bộ phận cơ học.');
INSERT INTO Faq_User (ask, answer) VALUES ('RAM, ROM và SSD là gì?', 'RAM là bộ nhớ tạm thời, tốc độ cao, dùng cho dữ liệu đang xử lý và mất nội dung khi tắt máy. ROM chứa dữ liệu cố định như firmware khởi động. Ổ cứng HDD hoặc SSD lưu dữ liệu lâu dài; SSD nhanh hơn HDD vì không có bộ phận cơ học.');
INSERT INTO Faq_User (ask, answer) VALUES ('CPU là gì?', 'CPU (bộ xử lý trung tâm) là thành phần thực thi các lệnh của chương trình bằng cách lặp lại chu trình lấy lệnh, giải mã và thực thi. Hiệu năng phụ thuộc vào số nhân, số luồng, xung nhịp (GHz) và bộ nhớ đệm.');
INSERT INTO Faq_User (ask, answer) VALUES ('CPU hoạt động như thế nào?', 'CPU (bộ xử lý trung tâm) là thành phần thực thi các lệnh của chương trình bằng cách lặp lại chu trình lấy lệnh, giải mã và thực thi. Hiệu năng phụ thuộc vào số nhân, số luồng, xung nhịp (GHz) và bộ nhớ đệm.');
INSERT INTO Faq_User (ask, answer) VALUES ('Các lệnh Linux cơ bản là gì?', 'Một số lệnh Linux cơ bản: ls liệt kê tệp, cd chuyển thư mục, pwd hiện thư mục hiện tại, mkdir tạo thư mục, rm xóa tệp, cp sao chép, mv di chuyển hoặc đổi tên, cat xem nội dung tệp, chmod đổi quyền truy cập, sudo chạy lệnh với quyền quản trị.');
INSERT INTO Faq_User (ask, answer) VALUES ('Lệnh ls, cd, mkdir, chmod trong Linux dùng để làm gì?', 'Một số lệnh Linux cơ bản: ls liệt kê tệp, cd chuyển thư mục, pwd hiện thư mục hiện tại, mkdir tạo thư mục, rm xóa tệp, cp sao chép, mv di chuyển hoặc đổi tên, cat xem nội dung tệp, chmod đổi quyền truy cập, sudo chạy lệnh với quyền quản trị.');
INSERT INTO Faq_User (ask, answer) VALUES ('Máy ảo (virtualization) là gì?', 'Ảo hóa cho phép chạy nhiều máy ảo (VM) độc lập trên một máy vật lý, mỗi máy ảo có hệ điều hành riêng. Phần mềm quản lý gọi là hypervisor, ví dụ VirtualBox, VMware, Hyper-V.');
INSERT INTO Faq_User (ask, answer) VALUES ('Virtual machine hoạt động như thế nào?', 'Ảo hóa cho phép chạy nhiều máy ảo (VM) độc lập trên một máy vật lý, mỗi máy ảo có hệ điều hành riêng. Phần mềm quản lý gọi là hypervisor, ví dụ VirtualBox, VMware, Hyper-V.');
-- ===== Mạng =====
INSERT INTO Faq_User (ask, answer) VALUES ('Mạng máy tính là gì?', 'Mạng máy tính là tập hợp các thiết bị kết nối để trao đổi dữ liệu. LAN là mạng cục bộ trong phạm vi nhỏ như phòng hoặc tòa nhà, MAN phủ một thành phố, WAN trải rộng trên phạm vi lớn như quốc gia hoặc toàn cầu; Internet là mạng WAN lớn nhất.');
INSERT INTO Faq_User (ask, answer) VALUES ('LAN, WAN và MAN khác nhau thế nào?', 'Mạng máy tính là tập hợp các thiết bị kết nối để trao đổi dữ liệu. LAN là mạng cục bộ trong phạm vi nhỏ như phòng hoặc tòa nhà, MAN phủ một thành phố, WAN trải rộng trên phạm vi lớn như quốc gia hoặc toàn cầu; Internet là mạng WAN lớn nhất.');
INSERT INTO Faq_User (ask, answer) VALUES ('Mô hình OSI gồm mấy tầng?', 'Mô hình OSI có 7 tầng, từ thấp đến cao: Vật lý, Liên kết dữ liệu, Mạng, Giao vận, Phiên, Trình diễn và Ứng dụng. Mô hình giúp chuẩn hóa và phân chia chức năng của quá trình truyền thông mạng.');
INSERT INTO Faq_User (ask, answer) VALUES ('7 tầng của mô hình OSI là gì?', 'Mô hình OSI có 7 tầng, từ thấp đến cao: Vật lý, Liên kết dữ liệu, Mạng, Giao vận, Phiên, Trình diễn và Ứng dụng. Mô hình giúp chuẩn hóa và phân chia chức năng của quá trình truyền thông mạng.');
INSERT INTO Faq_User (ask, answer) VALUES ('TCP và UDP khác nhau thế nào?', 'TCP là giao thức hướng kết nối, đảm bảo dữ liệu đến đủ và đúng thứ tự nên dùng cho web, email, truyền tệp. UDP không thiết lập kết nối và không đảm bảo, nhưng nhanh và nhẹ hơn, phù hợp cho video trực tiếp, game và gọi thoại.');
INSERT INTO Faq_User (ask, answer) VALUES ('Khi nào dùng TCP, khi nào dùng UDP?', 'TCP là giao thức hướng kết nối, đảm bảo dữ liệu đến đủ và đúng thứ tự nên dùng cho web, email, truyền tệp. UDP không thiết lập kết nối và không đảm bảo, nhưng nhanh và nhẹ hơn, phù hợp cho video trực tiếp, game và gọi thoại.');
INSERT INTO Faq_User (ask, answer) VALUES ('Địa chỉ IP là gì?', 'Địa chỉ IP là địa chỉ định danh của thiết bị trong mạng sử dụng giao thức Internet. IPv4 dài 32 bit (khoảng 4,3 tỷ địa chỉ) và đã gần cạn, IPv6 dài 128 bit với không gian địa chỉ gần như vô hạn.');
INSERT INTO Faq_User (ask, answer) VALUES ('IPv4 và IPv6 khác nhau thế nào?', 'Địa chỉ IP là địa chỉ định danh của thiết bị trong mạng sử dụng giao thức Internet. IPv4 dài 32 bit (khoảng 4,3 tỷ địa chỉ) và đã gần cạn, IPv6 dài 128 bit với không gian địa chỉ gần như vô hạn.');
INSERT INTO Faq_User (ask, answer) VALUES ('DNS là gì?', 'DNS (Domain Name System) là hệ thống phân giải tên miền, chuyển tên dễ nhớ như example.com thành địa chỉ IP mà máy tính dùng để kết nối. Có thể xem DNS như danh bạ của Internet.');
INSERT INTO Faq_User (ask, answer) VALUES ('Tên miền được chuyển thành địa chỉ IP như thế nào?', 'DNS (Domain Name System) là hệ thống phân giải tên miền, chuyển tên dễ nhớ như example.com thành địa chỉ IP mà máy tính dùng để kết nối. Có thể xem DNS như danh bạ của Internet.');
INSERT INTO Faq_User (ask, answer) VALUES ('HTTP và HTTPS khác nhau thế nào?', 'HTTP là giao thức truyền dữ liệu web ở dạng không mã hóa, thường dùng cổng 80. HTTPS là HTTP kết hợp mã hóa TLS/SSL, thường dùng cổng 443, giúp bảo vệ dữ liệu khỏi bị nghe lén hoặc chỉnh sửa và xác thực máy chủ.');
INSERT INTO Faq_User (ask, answer) VALUES ('Tại sao nên dùng HTTPS?', 'HTTP là giao thức truyền dữ liệu web ở dạng không mã hóa, thường dùng cổng 80. HTTPS là HTTP kết hợp mã hóa TLS/SSL, thường dùng cổng 443, giúp bảo vệ dữ liệu khỏi bị nghe lén hoặc chỉnh sửa và xác thực máy chủ.');
INSERT INTO Faq_User (ask, answer) VALUES ('Router và switch khác nhau thế nào?', 'Switch kết nối các thiết bị trong cùng một mạng LAN và chuyển dữ liệu dựa trên địa chỉ MAC. Router kết nối các mạng khác nhau (ví dụ mạng nhà bạn với Internet) và định tuyến gói tin dựa trên địa chỉ IP.');
INSERT INTO Faq_User (ask, answer) VALUES ('Bộ định tuyến và bộ chuyển mạch khác nhau ra sao?', 'Switch kết nối các thiết bị trong cùng một mạng LAN và chuyển dữ liệu dựa trên địa chỉ MAC. Router kết nối các mạng khác nhau (ví dụ mạng nhà bạn với Internet) và định tuyến gói tin dựa trên địa chỉ IP.');
INSERT INTO Faq_User (ask, answer) VALUES ('Webhook là gì?', 'Webhook là cơ chế để một hệ thống chủ động gửi yêu cầu HTTP tới địa chỉ do bạn cung cấp khi có sự kiện xảy ra, ví dụ Facebook gửi tin nhắn mới về chatbot. Khác với API thông thường là bạn phải liên tục hỏi, webhook đẩy dữ liệu đến cho bạn ngay khi có sự kiện.');
INSERT INTO Faq_User (ask, answer) VALUES ('Webhook khác API thông thường ở điểm nào?', 'Webhook là cơ chế để một hệ thống chủ động gửi yêu cầu HTTP tới địa chỉ do bạn cung cấp khi có sự kiện xảy ra, ví dụ Facebook gửi tin nhắn mới về chatbot. Khác với API thông thường là bạn phải liên tục hỏi, webhook đẩy dữ liệu đến cho bạn ngay khi có sự kiện.');
-- ===== Web =====
INSERT INTO Faq_User (ask, answer) VALUES ('HTML, CSS và JavaScript là gì?', 'HTML định nghĩa cấu trúc và nội dung trang web, CSS định dạng giao diện như màu sắc, bố cục, còn JavaScript thêm tính tương tác và logic chạy trên trình duyệt. Ba công nghệ này là nền tảng của phát triển web phía giao diện.');
INSERT INTO Faq_User (ask, answer) VALUES ('Vai trò của HTML, CSS, JavaScript trong trang web', 'HTML định nghĩa cấu trúc và nội dung trang web, CSS định dạng giao diện như màu sắc, bố cục, còn JavaScript thêm tính tương tác và logic chạy trên trình duyệt. Ba công nghệ này là nền tảng của phát triển web phía giao diện.');
INSERT INTO Faq_User (ask, answer) VALUES ('Frontend và backend khác nhau thế nào?', 'Frontend là phần người dùng nhìn thấy và tương tác trên trình duyệt hoặc ứng dụng. Backend là phần chạy trên máy chủ, xử lý logic nghiệp vụ, làm việc với cơ sở dữ liệu và cung cấp API cho frontend.');
INSERT INTO Faq_User (ask, answer) VALUES ('Lập trình viên frontend và backend làm những gì?', 'Frontend là phần người dùng nhìn thấy và tương tác trên trình duyệt hoặc ứng dụng. Backend là phần chạy trên máy chủ, xử lý logic nghiệp vụ, làm việc với cơ sở dữ liệu và cung cấp API cho frontend.');
INSERT INTO Faq_User (ask, answer) VALUES ('API là gì?', 'API (Application Programming Interface) là giao diện để các phần mềm giao tiếp với nhau. REST API là kiểu API dùng giao thức HTTP với các phương thức GET, POST, PUT, DELETE để thao tác tài nguyên, dữ liệu thường được trao đổi ở định dạng JSON.');
INSERT INTO Faq_User (ask, answer) VALUES ('REST API là gì?', 'API (Application Programming Interface) là giao diện để các phần mềm giao tiếp với nhau. REST API là kiểu API dùng giao thức HTTP với các phương thức GET, POST, PUT, DELETE để thao tác tài nguyên, dữ liệu thường được trao đổi ở định dạng JSON.');
INSERT INTO Faq_User (ask, answer) VALUES ('JSON là gì?', 'JSON (JavaScript Object Notation) là định dạng văn bản nhẹ để biểu diễn và trao đổi dữ liệu dưới dạng cặp khóa - giá trị, mảng và đối tượng lồng nhau. JSON dễ đọc với con người và được hầu hết ngôn ngữ lập trình hỗ trợ, nên rất phổ biến trong API.');
INSERT INTO Faq_User (ask, answer) VALUES ('Định dạng JSON dùng để làm gì?', 'JSON (JavaScript Object Notation) là định dạng văn bản nhẹ để biểu diễn và trao đổi dữ liệu dưới dạng cặp khóa - giá trị, mảng và đối tượng lồng nhau. JSON dễ đọc với con người và được hầu hết ngôn ngữ lập trình hỗ trợ, nên rất phổ biến trong API.');
INSERT INTO Faq_User (ask, answer) VALUES ('Framework và library khác nhau thế nào?', 'Thư viện (library) là tập hợp hàm bạn chủ động gọi khi cần. Framework quy định khung sườn của ứng dụng và gọi mã của bạn tại những điểm định sẵn (đảo ngược điều khiển). Ví dụ, NumPy là thư viện còn Django và Flask là framework.');
INSERT INTO Faq_User (ask, answer) VALUES ('Thư viện và framework khác nhau ở điểm nào?', 'Thư viện (library) là tập hợp hàm bạn chủ động gọi khi cần. Framework quy định khung sườn của ứng dụng và gọi mã của bạn tại những điểm định sẵn (đảo ngược điều khiển). Ví dụ, NumPy là thư viện còn Django và Flask là framework.');
INSERT INTO Faq_User (ask, answer) VALUES ('Flask là gì?', 'Flask là micro-framework viết bằng Python để xây dựng ứng dụng web và API. Flask gọn nhẹ, dễ học, cung cấp phần lõi như định tuyến và xử lý yêu cầu, còn các chức năng khác (cơ sở dữ liệu, đăng nhập) được thêm bằng các tiện ích mở rộng.');
INSERT INTO Faq_User (ask, answer) VALUES ('Flask dùng để làm gì trong Python?', 'Flask là micro-framework viết bằng Python để xây dựng ứng dụng web và API. Flask gọn nhẹ, dễ học, cung cấp phần lõi như định tuyến và xử lý yêu cầu, còn các chức năng khác (cơ sở dữ liệu, đăng nhập) được thêm bằng các tiện ích mở rộng.');
INSERT INTO Faq_User (ask, answer) VALUES ('Microservices là gì?', 'Monolith đóng gói toàn bộ ứng dụng thành một khối triển khai chung, đơn giản nhưng khó mở rộng khi lớn. Microservices chia ứng dụng thành nhiều dịch vụ nhỏ độc lập giao tiếp qua mạng, dễ mở rộng và triển khai riêng lẻ nhưng vận hành phức tạp hơn.');
INSERT INTO Faq_User (ask, answer) VALUES ('Kiến trúc monolith và microservices khác nhau thế nào?', 'Monolith đóng gói toàn bộ ứng dụng thành một khối triển khai chung, đơn giản nhưng khó mở rộng khi lớn. Microservices chia ứng dụng thành nhiều dịch vụ nhỏ độc lập giao tiếp qua mạng, dễ mở rộng và triển khai riêng lẻ nhưng vận hành phức tạp hơn.');
INSERT INTO Faq_User (ask, answer) VALUES ('Cache (bộ nhớ đệm) là gì?', 'Cache là nơi lưu tạm dữ liệu thường dùng ở vị trí truy cập nhanh hơn để lần sau không phải tính toán hoặc tải lại từ nguồn chậm. Cache giúp giảm độ trễ và tải cho máy chủ, nhưng cần quản lý việc làm mới để dữ liệu không bị cũ.');
INSERT INTO Faq_User (ask, answer) VALUES ('Caching giúp tăng tốc hệ thống như thế nào?', 'Cache là nơi lưu tạm dữ liệu thường dùng ở vị trí truy cập nhanh hơn để lần sau không phải tính toán hoặc tải lại từ nguồn chậm. Cache giúp giảm độ trễ và tải cho máy chủ, nhưng cần quản lý việc làm mới để dữ liệu không bị cũ.');
-- ===== Phần mềm =====
INSERT INTO Faq_User (ask, answer) VALUES ('Git là gì?', 'Git là hệ thống quản lý phiên bản phân tán, giúp theo dõi lịch sử thay đổi mã nguồn và làm việc nhóm. GitHub là dịch vụ lưu trữ kho Git trên Internet, bổ sung các tính năng cộng tác như pull request và quản lý dự án.');
INSERT INTO Faq_User (ask, answer) VALUES ('Git và GitHub khác nhau thế nào?', 'Git là hệ thống quản lý phiên bản phân tán, giúp theo dõi lịch sử thay đổi mã nguồn và làm việc nhóm. GitHub là dịch vụ lưu trữ kho Git trên Internet, bổ sung các tính năng cộng tác như pull request và quản lý dự án.');
INSERT INTO Faq_User (ask, answer) VALUES ('Các lệnh Git cơ bản là gì?', 'git init tạo kho mới, git add chọn thay đổi, git commit lưu thay đổi thành một phiên bản, git push đẩy lên kho từ xa, git pull lấy và gộp thay đổi mới, git branch tạo hoặc xem nhánh, git merge gộp nhánh.');
INSERT INTO Faq_User (ask, answer) VALUES ('Cách dùng git add, commit, push, pull, branch', 'git init tạo kho mới, git add chọn thay đổi, git commit lưu thay đổi thành một phiên bản, git push đẩy lên kho từ xa, git pull lấy và gộp thay đổi mới, git branch tạo hoặc xem nhánh, git merge gộp nhánh.');
INSERT INTO Faq_User (ask, answer) VALUES ('Vòng đời phát triển phần mềm (SDLC) gồm những giai đoạn nào?', 'SDLC thường gồm: thu thập và phân tích yêu cầu, thiết kế, lập trình, kiểm thử, triển khai và bảo trì. Các mô hình phổ biến là thác nước (waterfall), xoắn ốc và Agile.');
INSERT INTO Faq_User (ask, answer) VALUES ('Các bước của quy trình phát triển phần mềm', 'SDLC thường gồm: thu thập và phân tích yêu cầu, thiết kế, lập trình, kiểm thử, triển khai và bảo trì. Các mô hình phổ biến là thác nước (waterfall), xoắn ốc và Agile.');
INSERT INTO Faq_User (ask, answer) VALUES ('Agile và Scrum là gì?', 'Agile là phương pháp phát triển lặp ngắn, linh hoạt, liên tục nhận phản hồi. Scrum là một khung làm việc Agile chia công việc thành các sprint (thường 1 đến 4 tuần), với ba vai trò là Product Owner, Scrum Master và Development Team.');
INSERT INTO Faq_User (ask, answer) VALUES ('Scrum có những vai trò và sự kiện nào?', 'Agile là phương pháp phát triển lặp ngắn, linh hoạt, liên tục nhận phản hồi. Scrum là một khung làm việc Agile chia công việc thành các sprint (thường 1 đến 4 tuần), với ba vai trò là Product Owner, Scrum Master và Development Team.');
INSERT INTO Faq_User (ask, answer) VALUES ('Kiểm thử phần mềm là gì?', 'Kiểm thử phần mềm là quá trình tìm lỗi và xác nhận phần mềm đáp ứng yêu cầu. Unit test kiểm tra từng hàm hoặc mô-đun riêng lẻ, integration test kiểm tra các thành phần phối hợp với nhau, ngoài ra còn kiểm thử hệ thống và kiểm thử chấp nhận.');
INSERT INTO Faq_User (ask, answer) VALUES ('Unit test và integration test khác nhau thế nào?', 'Kiểm thử phần mềm là quá trình tìm lỗi và xác nhận phần mềm đáp ứng yêu cầu. Unit test kiểm tra từng hàm hoặc mô-đun riêng lẻ, integration test kiểm tra các thành phần phối hợp với nhau, ngoài ra còn kiểm thử hệ thống và kiểm thử chấp nhận.');
INSERT INTO Faq_User (ask, answer) VALUES ('UML là gì?', 'UML (Unified Modeling Language) là ngôn ngữ mô hình hóa trực quan dùng để phân tích và thiết kế phần mềm. Các sơ đồ thường dùng gồm sơ đồ use case, sơ đồ lớp (class), sơ đồ tuần tự (sequence) và sơ đồ hoạt động (activity).');
INSERT INTO Faq_User (ask, answer) VALUES ('Các sơ đồ UML thường dùng là gì?', 'UML (Unified Modeling Language) là ngôn ngữ mô hình hóa trực quan dùng để phân tích và thiết kế phần mềm. Các sơ đồ thường dùng gồm sơ đồ use case, sơ đồ lớp (class), sơ đồ tuần tự (sequence) và sơ đồ hoạt động (activity).');
INSERT INTO Faq_User (ask, answer) VALUES ('CI/CD là gì?', 'CI (Continuous Integration) là tự động build và kiểm thử mỗi khi có thay đổi mã được đẩy lên. CD (Continuous Delivery/Deployment) là tự động chuẩn bị hoặc triển khai bản phát hành, giúp phát hành nhanh và ít lỗi hơn.');
INSERT INTO Faq_User (ask, answer) VALUES ('Tích hợp liên tục và triển khai liên tục là gì?', 'CI (Continuous Integration) là tự động build và kiểm thử mỗi khi có thay đổi mã được đẩy lên. CD (Continuous Delivery/Deployment) là tự động chuẩn bị hoặc triển khai bản phát hành, giúp phát hành nhanh và ít lỗi hơn.');
INSERT INTO Faq_User (ask, answer) VALUES ('Docker là gì?', 'Docker là nền tảng đóng gói ứng dụng cùng môi trường chạy vào container để chạy giống nhau ở mọi nơi. Container dùng chung nhân hệ điều hành của máy chủ nên nhẹ và khởi động nhanh hơn máy ảo, vốn mang theo cả hệ điều hành riêng.');
INSERT INTO Faq_User (ask, answer) VALUES ('Container khác máy ảo ở điểm nào?', 'Docker là nền tảng đóng gói ứng dụng cùng môi trường chạy vào container để chạy giống nhau ở mọi nơi. Container dùng chung nhân hệ điều hành của máy chủ nên nhẹ và khởi động nhanh hơn máy ảo, vốn mang theo cả hệ điều hành riêng.');
-- ===== Đám mây =====
INSERT INTO Faq_User (ask, answer) VALUES ('Điện toán đám mây là gì?', 'Điện toán đám mây là cung cấp tài nguyên máy tính như máy chủ, lưu trữ, cơ sở dữ liệu qua Internet theo nhu cầu và trả phí theo mức sử dụng. Lợi ích là linh hoạt mở rộng, giảm chi phí đầu tư hạ tầng và triển khai nhanh; ví dụ AWS, Google Cloud, Microsoft Azure.');
INSERT INTO Faq_User (ask, answer) VALUES ('Cloud computing có lợi ích gì?', 'Điện toán đám mây là cung cấp tài nguyên máy tính như máy chủ, lưu trữ, cơ sở dữ liệu qua Internet theo nhu cầu và trả phí theo mức sử dụng. Lợi ích là linh hoạt mở rộng, giảm chi phí đầu tư hạ tầng và triển khai nhanh; ví dụ AWS, Google Cloud, Microsoft Azure.');
INSERT INTO Faq_User (ask, answer) VALUES ('IaaS, PaaS và SaaS khác nhau thế nào?', 'IaaS cung cấp hạ tầng như máy chủ ảo và mạng (ví dụ Amazon EC2). PaaS cung cấp nền tảng để triển khai ứng dụng mà không lo hạ tầng (ví dụ Heroku). SaaS cung cấp phần mềm hoàn chỉnh qua Internet (ví dụ Gmail, Google Docs).');
INSERT INTO Faq_User (ask, answer) VALUES ('Phân biệt các mô hình dịch vụ đám mây', 'IaaS cung cấp hạ tầng như máy chủ ảo và mạng (ví dụ Amazon EC2). PaaS cung cấp nền tảng để triển khai ứng dụng mà không lo hạ tầng (ví dụ Heroku). SaaS cung cấp phần mềm hoàn chỉnh qua Internet (ví dụ Gmail, Google Docs).');
INSERT INTO Faq_User (ask, answer) VALUES ('Big Data là gì?', 'Big Data là tập dữ liệu rất lớn, đa dạng và thay đổi nhanh, vượt khả năng xử lý của công cụ truyền thống. Các đặc trưng thường nêu là Volume (khối lượng), Velocity (tốc độ) và Variety (đa dạng), có thể thêm Veracity (độ tin cậy) và Value (giá trị).');
INSERT INTO Faq_User (ask, answer) VALUES ('Đặc trưng 3V của dữ liệu lớn là gì?', 'Big Data là tập dữ liệu rất lớn, đa dạng và thay đổi nhanh, vượt khả năng xử lý của công cụ truyền thống. Các đặc trưng thường nêu là Volume (khối lượng), Velocity (tốc độ) và Variety (đa dạng), có thể thêm Veracity (độ tin cậy) và Value (giá trị).');
INSERT INTO Faq_User (ask, answer) VALUES ('IoT là gì?', 'IoT (Internet of Things) là mạng các thiết bị vật lý có gắn cảm biến và kết nối Internet để thu thập, trao đổi dữ liệu và được điều khiển từ xa, ví dụ nhà thông minh, cảm biến nông nghiệp. Các vi điều khiển như ESP32 thường được dùng để xây dựng thiết bị IoT.');
INSERT INTO Faq_User (ask, answer) VALUES ('Internet vạn vật (IoT) hoạt động như thế nào?', 'IoT (Internet of Things) là mạng các thiết bị vật lý có gắn cảm biến và kết nối Internet để thu thập, trao đổi dữ liệu và được điều khiển từ xa, ví dụ nhà thông minh, cảm biến nông nghiệp. Các vi điều khiển như ESP32 thường được dùng để xây dựng thiết bị IoT.');
INSERT INTO Faq_User (ask, answer) VALUES ('Blockchain là gì?', 'Blockchain là sổ cái phân tán, trong đó dữ liệu được ghi thành các khối liên kết với nhau bằng hàm băm mật mã và được nhiều máy trong mạng cùng lưu giữ. Nhờ vậy dữ liệu đã ghi rất khó bị sửa đổi; ứng dụng nổi tiếng nhất là tiền mã hóa như Bitcoin.');
INSERT INTO Faq_User (ask, answer) VALUES ('Công nghệ blockchain hoạt động ra sao?', 'Blockchain là sổ cái phân tán, trong đó dữ liệu được ghi thành các khối liên kết với nhau bằng hàm băm mật mã và được nhiều máy trong mạng cùng lưu giữ. Nhờ vậy dữ liệu đã ghi rất khó bị sửa đổi; ứng dụng nổi tiếng nhất là tiền mã hóa như Bitcoin.');
INSERT INTO Faq_User (ask, answer) VALUES ('Sao lưu dữ liệu (backup) nên làm thế nào?', 'Sao lưu là tạo bản sao dữ liệu để khôi phục khi mất mát. Quy tắc 3-2-1 khuyến nghị giữ 3 bản sao dữ liệu, trên 2 loại phương tiện lưu trữ khác nhau, trong đó có 1 bản đặt ở vị trí khác (ví dụ đám mây).');
INSERT INTO Faq_User (ask, answer) VALUES ('Quy tắc sao lưu 3-2-1 là gì?', 'Sao lưu là tạo bản sao dữ liệu để khôi phục khi mất mát. Quy tắc 3-2-1 khuyến nghị giữ 3 bản sao dữ liệu, trên 2 loại phương tiện lưu trữ khác nhau, trong đó có 1 bản đặt ở vị trí khác (ví dụ đám mây).');
-- ===== ATTT =====
INSERT INTO Faq_User (ask, answer) VALUES ('An toàn thông tin là gì?', 'An toàn thông tin là việc bảo vệ thông tin và hệ thống khỏi truy cập, sử dụng hoặc phá hoại trái phép. Ba mục tiêu cốt lõi là Confidentiality (bí mật), Integrity (toàn vẹn) và Availability (sẵn sàng).');
INSERT INTO Faq_User (ask, answer) VALUES ('Ba yếu tố CIA trong an toàn thông tin là gì?', 'An toàn thông tin là việc bảo vệ thông tin và hệ thống khỏi truy cập, sử dụng hoặc phá hoại trái phép. Ba mục tiêu cốt lõi là Confidentiality (bí mật), Integrity (toàn vẹn) và Availability (sẵn sàng).');
INSERT INTO Faq_User (ask, answer) VALUES ('Virus, malware và ransomware là gì?', 'Malware là tên gọi chung của phần mềm độc hại. Virus tự gắn vào tệp khác và lây lan, trojan giả dạng phần mềm hữu ích để cài mã độc, còn ransomware mã hóa dữ liệu của nạn nhân rồi đòi tiền chuộc.');
INSERT INTO Faq_User (ask, answer) VALUES ('Phân biệt virus, trojan, ransomware', 'Malware là tên gọi chung của phần mềm độc hại. Virus tự gắn vào tệp khác và lây lan, trojan giả dạng phần mềm hữu ích để cài mã độc, còn ransomware mã hóa dữ liệu của nạn nhân rồi đòi tiền chuộc.');
INSERT INTO Faq_User (ask, answer) VALUES ('Phishing là gì?', 'Phishing là hình thức lừa đảo giả mạo tổ chức uy tín qua email, tin nhắn hoặc trang web để đánh cắp thông tin như mật khẩu, số thẻ. Dấu hiệu thường gặp: địa chỉ người gửi hoặc đường dẫn lạ, nội dung thúc giục khẩn cấp, yêu cầu cung cấp thông tin nhạy cảm; bạn không nên bấm vào liên kết đáng ngờ.');
INSERT INTO Faq_User (ask, answer) VALUES ('Làm sao nhận biết email lừa đảo phishing?', 'Phishing là hình thức lừa đảo giả mạo tổ chức uy tín qua email, tin nhắn hoặc trang web để đánh cắp thông tin như mật khẩu, số thẻ. Dấu hiệu thường gặp: địa chỉ người gửi hoặc đường dẫn lạ, nội dung thúc giục khẩn cấp, yêu cầu cung cấp thông tin nhạy cảm; bạn không nên bấm vào liên kết đáng ngờ.');
INSERT INTO Faq_User (ask, answer) VALUES ('Mã hóa đối xứng và bất đối xứng khác nhau thế nào?', 'Mã hóa đối xứng dùng cùng một khóa để mã hóa và giải mã, nhanh nhưng phải chia sẻ khóa an toàn, ví dụ AES. Mã hóa bất đối xứng dùng cặp khóa công khai và khóa bí mật, tiện cho trao đổi khóa và chữ ký số, ví dụ RSA, nhưng chậm hơn.');
INSERT INTO Faq_User (ask, answer) VALUES ('AES và RSA khác nhau ra sao?', 'Mã hóa đối xứng dùng cùng một khóa để mã hóa và giải mã, nhanh nhưng phải chia sẻ khóa an toàn, ví dụ AES. Mã hóa bất đối xứng dùng cặp khóa công khai và khóa bí mật, tiện cho trao đổi khóa và chữ ký số, ví dụ RSA, nhưng chậm hơn.');
INSERT INTO Faq_User (ask, answer) VALUES ('Tường lửa (firewall) là gì?', 'Tường lửa là hệ thống phần cứng hoặc phần mềm giám sát và lọc lưu lượng mạng vào ra theo các quy tắc đã đặt, nhằm chặn truy cập trái phép và giảm nguy cơ tấn công.');
INSERT INTO Faq_User (ask, answer) VALUES ('Firewall có tác dụng gì?', 'Tường lửa là hệ thống phần cứng hoặc phần mềm giám sát và lọc lưu lượng mạng vào ra theo các quy tắc đã đặt, nhằm chặn truy cập trái phép và giảm nguy cơ tấn công.');
INSERT INTO Faq_User (ask, answer) VALUES ('Làm thế nào để đặt mật khẩu mạnh?', 'Mật khẩu mạnh nên dài (từ 12 ký tự trở lên), kết hợp chữ hoa, chữ thường, số, ký tự đặc biệt, không dùng thông tin cá nhân và không dùng lại giữa nhiều tài khoản. Xác thực hai yếu tố (2FA) yêu cầu thêm một yếu tố như mã OTP hoặc ứng dụng xác thực, giúp bảo vệ tài khoản ngay cả khi lộ mật khẩu.');
INSERT INTO Faq_User (ask, answer) VALUES ('Xác thực hai yếu tố (2FA) là gì?', 'Mật khẩu mạnh nên dài (từ 12 ký tự trở lên), kết hợp chữ hoa, chữ thường, số, ký tự đặc biệt, không dùng thông tin cá nhân và không dùng lại giữa nhiều tài khoản. Xác thực hai yếu tố (2FA) yêu cầu thêm một yếu tố như mã OTP hoặc ứng dụng xác thực, giúp bảo vệ tài khoản ngay cả khi lộ mật khẩu.');
INSERT INTO Faq_User (ask, answer) VALUES ('SQL injection là gì?', 'SQL injection là kiểu tấn công chèn mã SQL độc hại vào dữ liệu đầu vào để thao túng hoặc đánh cắp dữ liệu trong cơ sở dữ liệu. Cách phòng chống chính là dùng truy vấn tham số hóa (prepared statement), kiểm tra dữ liệu đầu vào và phân quyền tối thiểu cho tài khoản cơ sở dữ liệu.');
INSERT INTO Faq_User (ask, answer) VALUES ('Cách phòng chống SQL injection', 'SQL injection là kiểu tấn công chèn mã SQL độc hại vào dữ liệu đầu vào để thao túng hoặc đánh cắp dữ liệu trong cơ sở dữ liệu. Cách phòng chống chính là dùng truy vấn tham số hóa (prepared statement), kiểm tra dữ liệu đầu vào và phân quyền tối thiểu cho tài khoản cơ sở dữ liệu.');
-- ===== AI =====
INSERT INTO Faq_User (ask, answer) VALUES ('Trí tuệ nhân tạo (AI) là gì?', 'Trí tuệ nhân tạo là lĩnh vực làm cho máy tính thực hiện các nhiệm vụ cần trí thông minh như hiểu ngôn ngữ, nhận dạng hình ảnh, ra quyết định. Học máy là một nhánh của AI học từ dữ liệu, còn học sâu là một nhánh của học máy dùng mạng nơ-ron nhiều lớp.');
INSERT INTO Faq_User (ask, answer) VALUES ('AI khác gì học máy và học sâu?', 'Trí tuệ nhân tạo là lĩnh vực làm cho máy tính thực hiện các nhiệm vụ cần trí thông minh như hiểu ngôn ngữ, nhận dạng hình ảnh, ra quyết định. Học máy là một nhánh của AI học từ dữ liệu, còn học sâu là một nhánh của học máy dùng mạng nơ-ron nhiều lớp.');
INSERT INTO Faq_User (ask, answer) VALUES ('Học máy (Machine Learning) là gì?', 'Học máy là phương pháp cho máy tính tự rút ra quy luật từ dữ liệu để dự đoán hoặc ra quyết định mà không cần lập trình từng quy tắc. Quy trình chung gồm thu thập dữ liệu, huấn luyện mô hình, đánh giá và đưa vào sử dụng.');
INSERT INTO Faq_User (ask, answer) VALUES ('Machine learning hoạt động như thế nào?', 'Học máy là phương pháp cho máy tính tự rút ra quy luật từ dữ liệu để dự đoán hoặc ra quyết định mà không cần lập trình từng quy tắc. Quy trình chung gồm thu thập dữ liệu, huấn luyện mô hình, đánh giá và đưa vào sử dụng.');
INSERT INTO Faq_User (ask, answer) VALUES ('Học sâu (Deep Learning) là gì?', 'Học sâu là nhánh của học máy sử dụng mạng nơ-ron nhân tạo nhiều lớp để tự học các đặc trưng phức tạp từ dữ liệu như ảnh, âm thanh, văn bản. Nó là nền tảng của nhận dạng hình ảnh, nhận dạng giọng nói và các mô hình ngôn ngữ lớn.');
INSERT INTO Faq_User (ask, answer) VALUES ('Mạng nơ-ron nhân tạo là gì?', 'Học sâu là nhánh của học máy sử dụng mạng nơ-ron nhân tạo nhiều lớp để tự học các đặc trưng phức tạp từ dữ liệu như ảnh, âm thanh, văn bản. Nó là nền tảng của nhận dạng hình ảnh, nhận dạng giọng nói và các mô hình ngôn ngữ lớn.');
INSERT INTO Faq_User (ask, answer) VALUES ('Học có giám sát, không giám sát và tăng cường khác nhau thế nào?', 'Học có giám sát học từ dữ liệu có nhãn để dự đoán (phân loại, hồi quy). Học không giám sát tìm cấu trúc trong dữ liệu không nhãn (phân cụm). Học tăng cường học cách hành động qua thử và sai để tối đa hóa phần thưởng.');
INSERT INTO Faq_User (ask, answer) VALUES ('Phân biệt ba loại học máy cơ bản', 'Học có giám sát học từ dữ liệu có nhãn để dự đoán (phân loại, hồi quy). Học không giám sát tìm cấu trúc trong dữ liệu không nhãn (phân cụm). Học tăng cường học cách hành động qua thử và sai để tối đa hóa phần thưởng.');
INSERT INTO Faq_User (ask, answer) VALUES ('Overfitting là gì?', 'Overfitting (quá khớp) là khi mô hình nhớ quá kỹ dữ liệu huấn luyện, kể cả nhiễu, nên dự đoán tốt trên dữ liệu đã thấy nhưng kém trên dữ liệu mới. Cách giảm gồm tăng dữ liệu, đơn giản hóa mô hình, dùng regularization và kiểm tra bằng tập kiểm định.');
INSERT INTO Faq_User (ask, answer) VALUES ('Hiện tượng quá khớp trong học máy là gì?', 'Overfitting (quá khớp) là khi mô hình nhớ quá kỹ dữ liệu huấn luyện, kể cả nhiễu, nên dự đoán tốt trên dữ liệu đã thấy nhưng kém trên dữ liệu mới. Cách giảm gồm tăng dữ liệu, đơn giản hóa mô hình, dùng regularization và kiểm tra bằng tập kiểm định.');
INSERT INTO Faq_User (ask, answer) VALUES ('Xử lý ngôn ngữ tự nhiên (NLP) là gì?', 'NLP là lĩnh vực giúp máy tính hiểu, phân tích và sinh ngôn ngữ của con người. Ứng dụng gồm chatbot, dịch máy, phân loại văn bản, phân tích cảm xúc và tìm kiếm ngữ nghĩa.');
INSERT INTO Faq_User (ask, answer) VALUES ('NLP dùng để làm gì?', 'NLP là lĩnh vực giúp máy tính hiểu, phân tích và sinh ngôn ngữ của con người. Ứng dụng gồm chatbot, dịch máy, phân loại văn bản, phân tích cảm xúc và tìm kiếm ngữ nghĩa.');
INSERT INTO Faq_User (ask, answer) VALUES ('Mô hình ngôn ngữ lớn (LLM) là gì?', 'LLM là mô hình học sâu dựa trên kiến trúc Transformer, được huấn luyện trên lượng văn bản rất lớn để dự đoán và sinh văn bản. Ví dụ gồm GPT, Gemini và Claude; chúng có thể trả lời câu hỏi, tóm tắt và viết mã, nhưng đôi khi sinh ra thông tin sai nên cần kiểm chứng.');
INSERT INTO Faq_User (ask, answer) VALUES ('LLM như GPT, Gemini hoạt động thế nào?', 'LLM là mô hình học sâu dựa trên kiến trúc Transformer, được huấn luyện trên lượng văn bản rất lớn để dự đoán và sinh văn bản. Ví dụ gồm GPT, Gemini và Claude; chúng có thể trả lời câu hỏi, tóm tắt và viết mã, nhưng đôi khi sinh ra thông tin sai nên cần kiểm chứng.');
INSERT INTO Faq_User (ask, answer) VALUES ('Embedding là gì?', 'Embedding là cách biểu diễn văn bản, hình ảnh hoặc dữ liệu khác thành một vector số sao cho các nội dung có nghĩa gần nhau nằm gần nhau trong không gian vector. Embedding là nền tảng của tìm kiếm ngữ nghĩa và hệ thống hỏi đáp.');
INSERT INTO Faq_User (ask, answer) VALUES ('Vector embedding dùng để làm gì?', 'Embedding là cách biểu diễn văn bản, hình ảnh hoặc dữ liệu khác thành một vector số sao cho các nội dung có nghĩa gần nhau nằm gần nhau trong không gian vector. Embedding là nền tảng của tìm kiếm ngữ nghĩa và hệ thống hỏi đáp.');
INSERT INTO Faq_User (ask, answer) VALUES ('RAG là gì?', 'RAG (Retrieval-Augmented Generation) là kỹ thuật kết hợp tìm kiếm thông tin với mô hình ngôn ngữ: hệ thống truy hồi các đoạn dữ liệu liên quan rồi đưa chúng vào câu lệnh để mô hình trả lời dựa trên dữ liệu đó. Nhờ vậy câu trả lời bám sát tri thức riêng và giảm tình trạng bịa thông tin.');
INSERT INTO Faq_User (ask, answer) VALUES ('Retrieval-Augmented Generation hoạt động thế nào?', 'RAG (Retrieval-Augmented Generation) là kỹ thuật kết hợp tìm kiếm thông tin với mô hình ngôn ngữ: hệ thống truy hồi các đoạn dữ liệu liên quan rồi đưa chúng vào câu lệnh để mô hình trả lời dựa trên dữ liệu đó. Nhờ vậy câu trả lời bám sát tri thức riêng và giảm tình trạng bịa thông tin.');
INSERT INTO Faq_User (ask, answer) VALUES ('FAISS là gì?', 'FAISS là thư viện mã nguồn mở của Meta dùng để tìm kiếm tương đồng và phân cụm trên các vector số chiều lớn. Thư viện này thường được dùng để tìm nhanh các vector gần nhất trong hệ thống tìm kiếm ngữ nghĩa và RAG.');
INSERT INTO Faq_User (ask, answer) VALUES ('Thư viện FAISS dùng để làm gì?', 'FAISS là thư viện mã nguồn mở của Meta dùng để tìm kiếm tương đồng và phân cụm trên các vector số chiều lớn. Thư viện này thường được dùng để tìm nhanh các vector gần nhất trong hệ thống tìm kiếm ngữ nghĩa và RAG.');
INSERT INTO Faq_User (ask, answer) VALUES ('Chatbot là gì?', 'Chatbot là chương trình mô phỏng cuộc hội thoại với người dùng qua tin nhắn hoặc giọng nói. Chatbot dựa trên quy tắc trả lời theo kịch bản có sẵn, còn chatbot dựa trên AI hiểu câu hỏi bằng NLP và có thể truy hồi hoặc sinh câu trả lời.');
INSERT INTO Faq_User (ask, answer) VALUES ('Chatbot hoạt động như thế nào?', 'Chatbot là chương trình mô phỏng cuộc hội thoại với người dùng qua tin nhắn hoặc giọng nói. Chatbot dựa trên quy tắc trả lời theo kịch bản có sẵn, còn chatbot dựa trên AI hiểu câu hỏi bằng NLP và có thể truy hồi hoặc sinh câu trả lời.');</sql><current_tab id="0"/></tab_sql></sqlb_project>
